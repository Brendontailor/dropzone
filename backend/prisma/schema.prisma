generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  nome         String
  email        String      @unique
  senhaHash    String
  role         Role        @default(CLIENTE)
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  id           Int         @id @default(autoincrement())
  avaliacoes   Avaliacao[]
  carrinhos    Carrinho[]
  favoritos    Favorito[]
}

model Categoria {
  nome     String    @unique
  criadoEm DateTime  @default(now())
  id       Int       @id @default(autoincrement())
  produtos Produto[]
}

model Produto {
  nome         String
  descricao    String
  preco        Decimal           @db.Decimal(10, 2)
  disponivel   Boolean           @default(true)
  destaque     Boolean           @default(false)
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  id           Int               @id @default(autoincrement())
  categoriaId  Int
  codigoLote   String?           @unique
  looks        LookProduto[]
  avaliacoes   Avaliacao[]
  favoritos    Favorito[]
  categoria    Categoria         @relation(fields: [categoriaId], references: [id])
  imagens      ProdutoImagem[]
  variacoes    ProdutoVariacao[]
}

model Cor {
  nome      String            @unique
  hex       String?
  id        Int               @id @default(autoincrement())
  imagens   ProdutoImagem[]
  variacoes ProdutoVariacao[]
}

model Tamanho {
  nome      String            @unique
  id        Int               @id @default(autoincrement())
  variacoes ProdutoVariacao[]
}

model ProdutoVariacao {
  disponivel    Boolean        @default(true)
  id            Int            @id @default(autoincrement())
  produtoId     Int
  corId         Int?
  tamanhoId     Int
  itensCarrinho ItemCarrinho[]
  cor           Cor?           @relation(fields: [corId], references: [id])
  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tamanho       Tamanho        @relation(fields: [tamanhoId], references: [id])

  @@unique([produtoId, corId, tamanhoId])
}

model ProdutoImagem {
  id        Int      @id @default(autoincrement())
  imagemUrl String
  produtoId Int
  corId     Int?
  criadoEm  DateTime @default(now())
  cor       Cor?     @relation(fields: [corId], references: [id])
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model Favorito {
  criadoEm  DateTime @default(now())
  id        Int      @id @default(autoincrement())
  usuarioId Int
  produtoId Int
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, produtoId])
}

model Avaliacao {
  nota          Int
  comentario    String?
  respostaAdmin String?
  criadoEm      DateTime @default(now())
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  produtoId     Int
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, produtoId])
}

model Carrinho {
  finalizado   Boolean        @default(false)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  id           Int            @id @default(autoincrement())
  usuarioId    Int
  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens        ItemCarrinho[]
}

model ItemCarrinho {
  quantidade        Int             @default(1)
  produtoVariacaoId Int
  id                Int             @id @default(autoincrement())
  carrinhoId        Int
  carrinho          Carrinho        @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  produtoVariacao   ProdutoVariacao @relation(fields: [produtoVariacaoId], references: [id])

  @@unique([carrinhoId, produtoVariacaoId])
}

enum Role {
  CLIENTE
  ADMIN
}

// Editorial administrável: produto ligado por ID, nunca pelo nome da imagem.
model Look {
  id           Int           @id @default(autoincrement())
  codigo       String        @unique
  nome         String
  descricao    String        @default("")
  imagemUrl    String
  ordem        Int           @default(0)
  publicado    Boolean       @default(true)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  itens        LookProduto[]
}

model LookProduto {
  lookId    Int
  produtoId Int
  ordem     Int     @default(0)
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([lookId, produtoId])
  @@index([produtoId])
}

// Registro técnico para evitar reimportar produtos excluídos pelo administrador.
model CatalogoImportacao {
  codigo String @id
  criadoEm DateTime @default(now())
}
