generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  nome         String
  email        String      @unique
  senhaHash    String
  role         Role        @default(CLIENTE)
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  id           Int         @id @default(autoincrement())
  avaliacoes   Avaliacao[]
  carrinhos    Carrinho[]
  favoritos    Favorito[]
}

model Categoria {
  nome     String    @unique
  criadoEm DateTime  @default(now())
  id       Int       @id @default(autoincrement())
  produtos Produto[]
}

model Produto {
  nome         String
  descricao    String
  preco        Decimal           @db.Decimal(10, 2)
  disponivel   Boolean           @default(true)
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  id           Int               @id @default(autoincrement())
  categoriaId  Int
  avaliacoes   Avaliacao[]
  favoritos    Favorito[]
  categoria    Categoria         @relation(fields: [categoriaId], references: [id])
  imagens      ProdutoImagem[]
  variacoes    ProdutoVariacao[]
}

model Cor {
  nome      String            @unique
  hex       String?
  id        Int               @id @default(autoincrement())
  imagens   ProdutoImagem[]
  variacoes ProdutoVariacao[]
}

model Tamanho {
  nome      String            @unique
  id        Int               @id @default(autoincrement())
  variacoes ProdutoVariacao[]
}

model ProdutoVariacao {
  disponivel    Boolean        @default(true)
  id            Int            @id @default(autoincrement())
  produtoId     Int
  corId         Int?
  tamanhoId     Int
  itensCarrinho ItemCarrinho[]
  cor           Cor?           @relation(fields: [corId], references: [id])
  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tamanho       Tamanho        @relation(fields: [tamanhoId], references: [id])

  @@unique([produtoId, corId, tamanhoId])
}

model ProdutoImagem {
  id        Int      @id @default(autoincrement())
  imagemUrl String
  produtoId Int
  corId     Int?
  criadoEm  DateTime @default(now())
  cor       Cor?     @relation(fields: [corId], references: [id])
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model Favorito {
  criadoEm  DateTime @default(now())
  id        Int      @id @default(autoincrement())
  usuarioId Int
  produtoId Int
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, produtoId])
}

model Avaliacao {
  nota       Int
  comentario String?
  criadoEm   DateTime @default(now())
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  produtoId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, produtoId])
}

model Carrinho {
  finalizado   Boolean        @default(false)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  id           Int            @id @default(autoincrement())
  usuarioId    Int
  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens        ItemCarrinho[]
}

model ItemCarrinho {
  quantidade        Int             @default(1)
  produtoVariacaoId Int
  id                Int             @id @default(autoincrement())
  carrinhoId        Int
  carrinho          Carrinho        @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  produtoVariacao   ProdutoVariacao @relation(fields: [produtoVariacaoId], references: [id])

  @@unique([carrinhoId, produtoVariacaoId])
}

enum Role {
  CLIENTE
  ADMIN
}
